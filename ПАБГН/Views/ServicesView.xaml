<UserControl x:Class="ПАБГН.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Дополнительные услуги" Style="{StaticResource Title}"/>
            <TextBlock Text="Завтраки, парковка, трансфер и другие услуги, добавляемые к брони"
                       Style="{StaticResource Subtitle}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,14,0">
                <DataGrid ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}"
                          Style="{StaticResource Table}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Цена"
                                            Binding="{Binding Price, StringFormat={}{0:N2} ₽}" Width="110"/>
                        <DataGridTextColumn Header="Единица" Binding="{Binding Unit}" Width="90"/>
                        <DataGridCheckBoxColumn Header="Действует" Binding="{Binding IsActive}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="Название услуги" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Цена, ₽" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditPrice, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Единица измерения" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Style="{StaticResource InputCombo}" ItemsSource="{Binding Units}"
                              SelectedItem="{Binding EditUnit}"/>

                    <CheckBox Content="Услуга действует" Margin="0,16,0,0" FontSize="13"
                              IsChecked="{Binding EditIsActive}"/>

                    <WrapPanel Margin="0,18,0,0">
                        <Button Content="Сохранить" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveCommand}"/>
                        <Button Content="Очистить" Style="{StaticResource SecondaryButton}"
                                Command="{Binding NewCommand}"/>
                        <Button Content="Удалить" Style="{StaticResource DangerButton}"
                                Command="{Binding DeleteCommand}"/>
                    </WrapPanel>

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource Subtitle}"
                               Text="Услугу нельзя удалить, если она использовалась в бронях — снимите признак «Услуга действует»."/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
