<UserControl x:Class="ПАБГН.Views.GuestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Гости" Style="{StaticResource Title}"/>
            <TextBlock Text="Картотека гостей и история бронирований" Style="{StaticResource Subtitle}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <!-- Список гостей -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12">
                    <DockPanel>
                        <TextBox DockPanel.Dock="Top" Style="{StaticResource Input}" Margin="0,0,0,10"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Поиск по ФИО, паспорту или телефону"/>
                        <DataGrid ItemsSource="{Binding Guests}"
                                  SelectedItem="{Binding SelectedGuest}"
                                  Style="{StaticResource Table}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                                <DataGridTextColumn Header="Паспорт" Binding="{Binding Passport}" Width="130"/>
                                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="130"/>
                                <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <TextBlock Grid.Row="1" Text="{Binding HistoryHeader}"
                           Style="{StaticResource SectionTitle}" Margin="0,14,0,6"/>

                <!-- История броней -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
                    <DataGrid ItemsSource="{Binding History}" Style="{StaticResource Table}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="110"/>
                            <DataGridTextColumn Header="Номер" Binding="{Binding Room.Number}" Width="70"/>
                            <DataGridTextColumn Header="Заезд"
                                                Binding="{Binding CheckIn, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                            <DataGridTextColumn Header="Выезд"
                                                Binding="{Binding CheckOut, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                            <DataGridTextColumn Header="Статус"
                                                Binding="{Binding Status, Converter={StaticResource EnumDisplay}}"
                                                Width="120"/>
                            <DataGridTextColumn Header="Стоимость"
                                                Binding="{Binding TotalPrice, StringFormat={}{0:N2} ₽}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- Форма гостя -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="ФИО" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding EditFullName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Паспорт (серия и номер)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding EditPassport, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Телефон" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="E-mail" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Дата рождения" Style="{StaticResource FieldLabel}"/>
                        <DatePicker Style="{StaticResource InputDate}" SelectedDate="{Binding EditBirthDate}"/>

                        <TextBlock Text="Адрес" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource Input}" TextWrapping="Wrap"
                                 Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Примечание" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource Input}" Height="56" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalContentAlignment="Top"
                                 Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"/>

                        <WrapPanel Margin="0,18,0,0">
                            <Button Content="Сохранить" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveCommand}"/>
                            <Button Content="Очистить" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding NewCommand}"/>
                            <Button Content="Удалить" Style="{StaticResource DangerButton}"
                                    Command="{Binding DeleteCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
