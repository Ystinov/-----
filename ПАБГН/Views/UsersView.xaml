<UserControl x:Class="ПАБГН.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Сотрудники гостиницы" Style="{StaticResource Title}"/>
            <TextBlock Text="Учётные записи и права доступа. Раздел доступен только администратору."
                       Style="{StaticResource Subtitle}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,14,0">
                <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                          Style="{StaticResource Table}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="130"/>
                        <DataGridTextColumn Header="Роль"
                                            Binding="{Binding Role, Converter={StaticResource EnumDisplay}}"
                                            Width="140"/>
                        <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="ФИО сотрудника" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditFullName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Логин" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditLogin, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Роль" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Style="{StaticResource InputCombo}" ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding EditRole}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="PasswordInput" Padding="8,6" FontSize="13"
                                 BorderBrush="{StaticResource Brush.Border}"
                                 VerticalContentAlignment="Center"/>
                    <TextBlock Text="Для существующего сотрудника оставьте поле пустым, чтобы не менять пароль."
                               Style="{StaticResource Subtitle}" Margin="0,6,0,0"/>

                    <CheckBox Content="Учётная запись активна" Margin="0,16,0,0" FontSize="13"
                              IsChecked="{Binding EditIsActive}"/>

                    <WrapPanel Margin="0,18,0,0">
                        <Button Content="Сохранить" Style="{StaticResource PrimaryButton}"
                                Click="OnSaveClick"/>
                        <Button Content="Очистить" Style="{StaticResource SecondaryButton}"
                                Click="OnClearClick"/>
                        <Button Content="Удалить" Style="{StaticResource DangerButton}"
                                Command="{Binding DeleteCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
