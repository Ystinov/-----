<UserControl x:Class="ПАБГН.Views.BookingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Брони" Style="{StaticResource Title}"/>
            <TextBlock Text="{Binding Statistics}" Style="{StaticResource Subtitle}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Панель фильтра -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Статус:" VerticalAlignment="Center" FontSize="13"
                       Foreground="{StaticResource Brush.Muted}" Margin="0,0,8,0"/>
            <ComboBox Style="{StaticResource InputCombo}" Width="200"
                      ItemsSource="{Binding StatusFilters}"
                      SelectedItem="{Binding SelectedFilter}"
                      DisplayMemberPath="Title"/>
            <Button Content="Оформить новую бронь" Style="{StaticResource PrimaryButton}"
                    Margin="16,0,0,0" Command="{Binding NewBookingCommand}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12">
                    <DataGrid ItemsSource="{Binding Bookings}" SelectedItem="{Binding SelectedBooking}"
                              Style="{StaticResource Table}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="110"/>
                            <DataGridTextColumn Header="Гость" Binding="{Binding Guest.FullName}" Width="*"/>
                            <DataGridTextColumn Header="Номер" Binding="{Binding Room.Number}" Width="70"/>
                            <DataGridTextColumn Header="Заезд"
                                                Binding="{Binding CheckIn, StringFormat={}{0:dd.MM.yyyy}}" Width="95"/>
                            <DataGridTextColumn Header="Выезд"
                                                Binding="{Binding CheckOut, StringFormat={}{0:dd.MM.yyyy}}" Width="95"/>
                            <DataGridTextColumn Header="Статус"
                                                Binding="{Binding Status, Converter={StaticResource EnumDisplay}}"
                                                Width="120"/>
                            <DataGridTextColumn Header="Стоимость"
                                                Binding="{Binding TotalPrice, StringFormat={}{0:N2} ₽}" Width="110"/>
                            <DataGridTextColumn Header="Оплата"
                                                Binding="{Binding PaymentStatus, Converter={StaticResource EnumDisplay}}"
                                                Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12">
                    <TextBlock Text="{Binding DetailsText}" Style="{StaticResource Subtitle}"
                               Foreground="{StaticResource Brush.Text}"/>
                </Border>
            </Grid>

            <!-- Действия -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Действия по брони" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Сначала выберите бронь в таблице."
                                   Style="{StaticResource Subtitle}"/>

                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="Подтвердить" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,6,6" Command="{Binding ConfirmCommand}"/>
                            <Button Content="Заселить" Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,6,6" Command="{Binding CheckInCommand}"/>
                            <Button Content="Выселить" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,6,6" Command="{Binding CheckOutCommand}"/>
                        </WrapPanel>

                        <Separator Margin="0,16,0,12"/>

                        <TextBlock Text="Продление проживания" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Новая дата выезда" Style="{StaticResource FieldLabel}"/>
                        <DatePicker Style="{StaticResource InputDate}" SelectedDate="{Binding ExtendDate}"/>
                        <Button Content="Продлить" Style="{StaticResource PrimaryButton}"
                                Margin="0,12,0,0" HorizontalAlignment="Left"
                                Command="{Binding ExtendCommand}"/>

                        <Separator Margin="0,16,0,12"/>

                        <TextBlock Text="Оплата" Style="{StaticResource SectionTitle}"/>
                        <Button Content="Перейти к оплате брони" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Command="{Binding PayCommand}"/>

                        <Separator Margin="0,16,0,12"/>

                        <TextBlock Text="Отмена" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Отмена возможна только до заселения гостя."
                                   Style="{StaticResource Subtitle}"/>
                        <Button Content="Отменить бронь" Style="{StaticResource DangerButton}"
                                Margin="0,10,0,0" HorizontalAlignment="Left"
                                Command="{Binding CancelCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
