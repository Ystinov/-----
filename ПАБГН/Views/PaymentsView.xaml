<UserControl x:Class="ПАБГН.Views.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Оплата проживания" Style="{StaticResource Title}"/>
            <TextBlock Text="{Binding BookingInfo}" Style="{StaticResource Subtitle}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Итоги по брони -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Стоимость брони" Style="{StaticResource Subtitle}"/>
                    <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:N2} ₽}" FontSize="20"
                               FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Оплачено" Style="{StaticResource Subtitle}"/>
                    <TextBlock Text="{Binding PaidAmount, StringFormat={}{0:N2} ₽}" FontSize="20"
                               FontWeight="SemiBold" Foreground="{StaticResource Brush.Primary}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Остаток к оплате" Style="{StaticResource Subtitle}"/>
                    <TextBlock Text="{Binding Debt, StringFormat={}{0:N2} ₽}" FontSize="20"
                               FontWeight="SemiBold" Foreground="{StaticResource Brush.Danger}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Форма платежа -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="Сумма, ₽" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Text="Тип платежа" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                    <ComboBox Style="{StaticResource InputCombo}" ItemsSource="{Binding Types}"
                              SelectedItem="{Binding Type}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,14,0">
                    <TextBlock Text="Способ оплаты" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                    <ComboBox Style="{StaticResource InputCombo}" ItemsSource="{Binding Methods}"
                              SelectedItem="{Binding Method}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,14,0">
                    <TextBlock Text="Примечание" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <Button Grid.Column="4" Content="Добавить платёж" Style="{StaticResource PrimaryButton}"
                        Margin="0" Padding="18,8" VerticalAlignment="Bottom"
                        Command="{Binding AddCommand}"/>
            </Grid>
        </Border>

        <!-- История платежей -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="История платежей по брони"
                           Style="{StaticResource SectionTitle}"/>
                <DataGrid ItemsSource="{Binding Payments}" Style="{StaticResource Table}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата и время"
                                            Binding="{Binding PaidAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="170"/>
                        <DataGridTextColumn Header="Тип"
                                            Binding="{Binding Type, Converter={StaticResource EnumDisplay}}" Width="150"/>
                        <DataGridTextColumn Header="Способ"
                                            Binding="{Binding Method, Converter={StaticResource EnumDisplay}}" Width="180"/>
                        <DataGridTextColumn Header="Сумма"
                                            Binding="{Binding Amount, StringFormat={}{0:N2} ₽}" Width="120"/>
                        <DataGridTextColumn Header="Примечание" Binding="{Binding Comment}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
