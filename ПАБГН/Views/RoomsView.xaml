<UserControl x:Class="ПАБГН.Views.RoomsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Номерной фонд" Style="{StaticResource Title}"/>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Subtitle}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Таблица номеров -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0" Padding="12">
                <DockPanel>
                    <TextBox DockPanel.Dock="Top" Style="{StaticResource Input}" Margin="0,0,0,10"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Поиск по номеру, категории или этажу"/>
                    <DataGrid ItemsSource="{Binding Rooms}"
                              SelectedItem="{Binding SelectedRoom}"
                              Style="{StaticResource Table}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="80"/>
                            <DataGridTextColumn Header="Этаж" Binding="{Binding Floor}" Width="60"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="*"/>
                            <DataGridTextColumn Header="Мест" Binding="{Binding Category.Capacity}" Width="60"/>
                            <DataGridTextColumn Header="Цена/ночь"
                                                Binding="{Binding Category.PricePerNight, StringFormat={}{0:N2} ₽}"
                                                Width="110"/>
                            <DataGridTextColumn Header="Статус"
                                                Binding="{Binding Status, Converter={StaticResource EnumDisplay}}"
                                                Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Форма номера -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Форма редактирования доступна только управляющему гостиницей -->
                        <StackPanel Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="Номер комнаты" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding EditNumber, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Этаж" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding EditFloor, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Категория" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource InputCombo}" ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding EditCategory}" DisplayMemberPath="Name"/>
                        <TextBlock Text="{Binding EditPrice}" Style="{StaticResource Subtitle}" Margin="0,6,0,0"/>

                        <TextBlock Text="Статус" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource InputCombo}" ItemsSource="{Binding Statuses}"
                                  SelectedItem="{Binding EditStatus}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Примечание" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource Input}" Height="56" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalContentAlignment="Top"
                                 Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"/>

                        <WrapPanel Margin="0,18,0,0">
                            <Button Content="Сохранить" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveCommand}"/>
                            <Button Content="Очистить" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding NewCommand}"/>
                            <Button Content="Удалить" Style="{StaticResource DangerButton}"
                                    Command="{Binding DeleteCommand}"/>
                        </WrapPanel>

                        <Separator Margin="0,18,0,12"/>
                        </StackPanel>

                        <TextBlock Text="Смена состояния номера" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <TextBlock Text="Применяется к номеру, выбранному в таблице."
                                   Style="{StaticResource Subtitle}" Margin="0,4,0,0"/>

                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Свободен" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"
                                    Command="{Binding SetStatusCommand}" CommandParameter="Available"/>
                            <Button Content="Занят" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"
                                    Command="{Binding SetStatusCommand}" CommandParameter="Occupied"/>
                            <Button Content="Уборка" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"
                                    Command="{Binding SetStatusCommand}" CommandParameter="Cleaning"/>
                            <Button Content="Ремонт" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"
                                    Command="{Binding SetStatusCommand}" CommandParameter="Maintenance"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
