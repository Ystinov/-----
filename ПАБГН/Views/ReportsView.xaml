<UserControl x:Class="ПАБГН.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Отчёты" Style="{StaticResource Title}"/>
            <TextBlock Text="Загрузка номерного фонда, выручка за период и экспорт данных"
                       Style="{StaticResource Subtitle}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Период отчёта -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Период с" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                    <DatePicker Style="{StaticResource InputDate}" Width="160" SelectedDate="{Binding From}"/>
                </StackPanel>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="по" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                    <DatePicker Style="{StaticResource InputDate}" Width="160" SelectedDate="{Binding To}"/>
                </StackPanel>
                <Button Content="Построить отчёт" Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Bottom" Padding="18,8" Margin="0,0,8,0"
                        Command="{Binding BuildCommand}"/>
                <Button Content="Экспорт в CSV" Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Bottom" Padding="18,8" Margin="0"
                        Command="{Binding ExportCommand}"/>
            </StackPanel>
        </Border>

        <!-- Показатели -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Выручка за период" Style="{StaticResource Subtitle}"/>
                    <TextBlock Text="{Binding Revenue, StringFormat={}{0:N2} ₽}" FontSize="20"
                               FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Средняя загрузка номерного фонда" Style="{StaticResource Subtitle}"/>
                    <TextBlock Text="{Binding OccupancyText}" FontSize="20"
                               FontWeight="SemiBold" Foreground="{StaticResource Brush.Primary}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Броней в периоде" Style="{StaticResource Subtitle}"/>
                    <TextBlock Text="{Binding Bookings.Count}" FontSize="20"
                               FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}"
                           Style="{StaticResource Subtitle}" Margin="0,0,0,10"/>
                <DataGrid ItemsSource="{Binding Bookings}" Style="{StaticResource Table}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="110"/>
                        <DataGridTextColumn Header="Гость" Binding="{Binding Guest.FullName}" Width="*"/>
                        <DataGridTextColumn Header="Номер" Binding="{Binding Room.Number}" Width="70"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding Room.Category.Name}" Width="150"/>
                        <DataGridTextColumn Header="Заезд"
                                            Binding="{Binding CheckIn, StringFormat={}{0:dd.MM.yyyy}}" Width="95"/>
                        <DataGridTextColumn Header="Выезд"
                                            Binding="{Binding CheckOut, StringFormat={}{0:dd.MM.yyyy}}" Width="95"/>
                        <DataGridTextColumn Header="Ночей" Binding="{Binding Nights}" Width="60"/>
                        <DataGridTextColumn Header="Статус"
                                            Binding="{Binding Status, Converter={StaticResource EnumDisplay}}"
                                            Width="120"/>
                        <DataGridTextColumn Header="Стоимость"
                                            Binding="{Binding TotalPrice, StringFormat={}{0:N2} ₽}" Width="110"/>
                        <DataGridTextColumn Header="Оплачено"
                                            Binding="{Binding PaidAmount, StringFormat={}{0:N2} ₽}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
