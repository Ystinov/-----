<UserControl x:Class="ПАБГН.Views.NewBookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Оформление брони" Style="{StaticResource Title}"/>
            <TextBlock Text="Укажите период и число гостей, подберите свободный номер, выберите гостя и услуги"
                       Style="{StaticResource Subtitle}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Параметры подбора -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="Дата заезда" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                    <DatePicker Style="{StaticResource InputDate}" SelectedDate="{Binding CheckIn}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Text="Дата выезда" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                    <DatePicker Style="{StaticResource InputDate}" SelectedDate="{Binding CheckOut}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,14,0">
                    <TextBlock Text="Гостей" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                    <TextBox Style="{StaticResource Input}" Text="{Binding GuestsCount, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,14,0">
                    <TextBlock Text="Категория" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                    <ComboBox Style="{StaticResource InputCombo}" ItemsSource="{Binding CategoryFilters}"
                              SelectedItem="{Binding CategoryFilter}" DisplayMemberPath="Name"/>
                </StackPanel>

                <Button Grid.Column="4" Content="Найти свободные номера"
                        Style="{StaticResource PrimaryButton}" Margin="0"
                        VerticalAlignment="Bottom" Padding="18,8"
                        Command="{Binding SearchCommand}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Свободные номера -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,14,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Свободные номера на выбранный период"
                               Style="{StaticResource SectionTitle}"/>
                    <DataGrid ItemsSource="{Binding AvailableRooms}"
                              SelectedItem="{Binding SelectedRoom}"
                              Style="{StaticResource Table}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="80"/>
                            <DataGridTextColumn Header="Этаж" Binding="{Binding Floor}" Width="60"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="*"/>
                            <DataGridTextColumn Header="Мест" Binding="{Binding Category.Capacity}" Width="60"/>
                            <DataGridTextColumn Header="Цена/ночь"
                                                Binding="{Binding Category.PricePerNight, StringFormat={}{0:N2} ₽}"
                                                Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Гость, услуги, стоимость -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Гость" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="Поиск по ФИО, паспорту или телефону" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding GuestSearch, UpdateSourceTrigger=PropertyChanged}"/>

                        <ComboBox Style="{StaticResource InputCombo}" Margin="0,8,0,0"
                                  MaxDropDownHeight="200"
                                  ItemsSource="{Binding Guests}"
                                  SelectedItem="{Binding SelectedGuest}"
                                  DisplayMemberPath="FullName"/>

                        <Separator Margin="0,16,0,12"/>

                        <TextBlock Text="Дополнительные услуги" Style="{StaticResource SectionTitle}"/>
                        <ItemsControl ItemsSource="{Binding Services}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Content="{Binding Title}" FontSize="12.5"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsSelected}"/>
                                        <TextBox Grid.Column="1" Style="{StaticResource Input}" Padding="6,3"
                                                 Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsSelected}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,16,0,12"/>

                        <TextBlock Text="Примечание к брони" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource Input}" Height="48" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalContentAlignment="Top"
                                 Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"/>

                        <Border Background="#F0F5FF" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding PriceDetails}" Style="{StaticResource Subtitle}"/>
                                <TextBlock Margin="0,10,0,0" FontSize="13">
                                    <Run Text="Проживание:" Foreground="#6B7684"/>
                                    <Run Text="{Binding AccommodationPrice, Mode=OneWay, StringFormat={}{0:N2} ₽}" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock Margin="0,4,0,0" FontSize="13">
                                    <Run Text="Услуги:" Foreground="#6B7684"/>
                                    <Run Text="{Binding ServicesPrice, Mode=OneWay, StringFormat={}{0:N2} ₽}" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock Margin="0,8,0,0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Brush.Primary}">
                                    <Run Text="Итого:" Foreground="#6B7684" FontSize="13"/>
                                    <Run Text="{Binding TotalPrice, Mode=OneWay, StringFormat={}{0:N2} ₽}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="Оформить бронь" Style="{StaticResource PrimaryButton}"
                                    Padding="20,10" Command="{Binding CreateCommand}"/>
                            <Button Content="Сбросить" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ResetCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
